# ============================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ============================================
# Этот файл — только для справки! 
# Настоящие секреты (токены, пароли) мы вводим в панели Railway,
# а не в код. Этот файл показывает, какие настройки нужны.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Режим работы: polling (пока) или webhook (потом)
BOT_MODE=polling

# Адрес базы данных (Railway даст свой автоматически)
DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# Тариф по умолчанию для новых пользователей: lite / pro / business
DEFAULT_TARIFF=lite

# API-ключи для AI (пока не нужны, добавим на Этапе 3)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
