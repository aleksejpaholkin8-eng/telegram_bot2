# ============================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ============================================
# Этот файл — только для справки! 
# Настоящие секреты (токены, пароли) мы вводим в панели Railway,
# а не в код. Этот файл показывает, какие настройки нужны.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Твой Telegram ID — даёт доступ к /admin, /upload_prompt, /settariff (обязательно)
OWNER_ID=123456789

# Ключ шифрования для BYOK-ключей пользователей (обязательно для /setkey)
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Режим работы: polling (пока) или webhook (потом)
BOT_MODE=polling

# Адрес базы данных (Railway даст свой автоматически)
DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# Тариф по умолчанию для новых пользователей: lite / pro / business
DEFAULT_TARIFF=lite

# API-ключи для AI (владельца бота, режим owner)
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
